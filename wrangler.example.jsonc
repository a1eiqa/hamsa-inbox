{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hamsa-inbox",
  "main": "dist/server/index.js",
  "compatibility_date": "2025-06-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hamsa-inbox",
      "database_id": "YOUR_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ]
}
